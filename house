<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mentoring League Society House — Book 2026</title>
<link href="https://fonts.googleapis.com/css2?family=Abril+Text:ital,wght@1,400;1,600;1,700&family=Quicksand:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --navy: #001424;
    --navy-mid: #0d324f;
    --navy-light: #285478;
    --blue-accent: #527ea3;
    --blue-glow: #8ab0cf;
    --gold: #8ab0cf;
    --gold-light: #cfe6f8;
    --white: #f5f3ef;
    --white-dim: rgba(245,243,239,0.7);
    --white-faint: rgba(245,243,239,0.15);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--navy);
    color: var(--white);
    font-family: 'Quicksand', sans-serif;
    font-weight: 300;
    overflow-x: hidden;
  }

  /* NAV */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 60px;
    background: linear-gradient(to bottom, rgba(8,15,30,0.95), transparent);
    backdrop-filter: blur(2px);
  }
  .nav-logo {
    font-family: 'Quicksand', sans-serif;
    font-size: 13px;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 400;
  }
  .nav-links {
    display: flex;
    gap: 36px;
    list-style: none;
  }
  .nav-links a {
    font-family: 'Quicksand', sans-serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--white-dim);
    text-decoration: none;
    transition: color 0.3s;
  }
  .nav-links a:hover { color: var(--gold); }

  /* PAGES */
  .page {
    min-height: 100vh;
    width: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }

  /* ============ CAPA ============ */
  #capa {
    background: var(--navy);
    align-items: center;
    text-align: center;
  }
  .capa-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 50% 70%, rgba(40,84,120,0.5) 0%, transparent 70%),
      radial-gradient(ellipse 40% 40% at 20% 20%, rgba(207,230,248,0.1) 0%, transparent 60%),
      linear-gradient(180deg, var(--navy) 0%, #001424 50%, var(--navy) 100%);
  }
  .capa-line-top {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
  }
  .capa-line-bottom {
    position: absolute;
    bottom: 80px; left: 60px; right: 60px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--white-faint), transparent);
  }
  .capa-content {
    position: relative;
    z-index: 2;
    padding: 120px 60px 160px;
  }
  .capa-eyebrow {
    font-family: 'Quicksand', sans-serif;
    font-size: 11px;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 48px;
    opacity: 0;
    animation: fadeUp 1s ease 0.3s forwards;
  }
  .capa-title {
    font-family: 'Abril Text', serif;
    font-style: italic;
    font-size: clamp(36px, 5vw, 72px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--white);
    margin-bottom: 16px;
    opacity: 0;
    animation: fadeUp 1s ease 0.6s forwards;
  }
  .capa-title em {
    font-family: 'Abril Text', serif;
    font-style: italic;
    font-weight: 400;
    color: var(--gold);
    font-size: 0.85em;
    vertical-align: baseline;
  }
  .capa-subtitle {
    font-family: 'Quicksand', sans-serif;
    font-size: clamp(14px, 2vw, 20px);
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--white-dim);
    font-weight: 300;
    margin-top: 32px;
    opacity: 0;
    animation: fadeUp 1s ease 0.9s forwards;
  }
  .capa-year {
    position: absolute;
    bottom: 28px;
    right: 60px;
    font-family: 'Quicksand', sans-serif;
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--white-dim);
    z-index: 2;
  }
  .capa-left-label {
    position: absolute;
    bottom: 28px;
    left: 60px;
    font-family: 'Quicksand', sans-serif;
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--white-dim);
    z-index: 2;
  }

  /* ============ MANIFESTO ============ */
  #manifesto {
    background: var(--navy-mid);
    padding: 120px 0;
  }
  .manifesto-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 60px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .manifesto-quote {
    font-family: 'Abril Text', serif;
    font-style: italic;
    font-size: clamp(42px, 5vw, 72px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  .manifesto-quote em {
    
    color: var(--gold);
  }
  .manifesto-text p {
    font-size: 16px;
    line-height: 1.85;
    color: var(--white-dim);
    margin-bottom: 24px;
  }
  .manifesto-text p:last-child { margin-bottom: 0; }

  /* ============ ECOSSISTEMA ============ */
  #ecossistema {
    background: var(--navy);
    padding: 120px 0;
  }
  .section-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 60px;
  }
  .section-label {
    font-family: 'Quicksand', sans-serif;
    font-size: 11px;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 20px;
  }
  .section-title {
    font-family: 'Abril Text', serif;
    font-style: italic;
    font-size: clamp(36px, 4vw, 58px);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 60px;
  }
  .section-title em {
    
    color: var(--gold);
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px;
    margin-bottom: 80px;
  }
  .stat-card {
    background: var(--navy-light);
    padding: 48px 32px;
    border-top: 1px solid var(--white-faint);
  }
  .stat-number {
    font-family: 'Abril Text', serif;
    font-style: italic;
    font-size: 64px;
    font-weight: 300;
    line-height: 1;
    color: var(--gold);
    margin-bottom: 12px;
  }
  .stat-label {
    font-family: 'Quicksand', sans-serif;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--white-dim);
  }
  .eco-text {
    max-width: 640px;
    font-size: 17px;
    line-height: 1.8;
    color: var(--white-dim);
    border-left: 1px solid var(--gold);
    padding-left: 32px;
  }

  /* ============ PROJETO ============ */
  #projeto {
    background: var(--navy-mid);
    padding: 120px 0;
  }
  .projeto-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    min-height: 70vh;
  }
  .projeto-visual {
    background: var(--navy-light);
    position: relative;
    min-height: 500px;
    overflow: hidden;
  }
  .projeto-visual-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--navy-light) 0%, var(--blue-accent) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Quicksand', sans-serif;
    font-size: 120px;
    font-weight: 300;
    color: var(--white-faint);
    letter-spacing: -0.05em;
  }
  .projeto-content {
    padding: 80px 70px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .projeto-content p {
    font-size: 16px;
    line-height: 1.85;
    color: var(--white-dim);
    margin-bottom: 24px;
  }
  .projeto-tag {
    display: inline-block;
    font-family: 'Quicksand', sans-serif;
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    border: 1px solid var(--white-faint);
    padding: 8px 20px;
    margin-top: 16px;
    color: var(--white-dim);
  }

  /* ============ LOCALIZAÇÃO ============ */
  #localizacao {
    background: var(--navy);
    padding: 120px 0;
  }
  .loc-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .loc-address {
    font-family: 'Quicksand', sans-serif;
    font-size: 22px;
    
    color: var(--gold);
    margin-bottom: 32px;
    letter-spacing: 0.02em;
  }
  .loc-text p {
    font-size: 16px;
    line-height: 1.85;
    color: var(--white-dim);
    margin-bottom: 20px;
  }
  .loc-map-placeholder {
    background: var(--navy-light);
    border: 1px solid var(--white-faint);
    height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 16px;
    font-family: 'Quicksand', sans-serif;
    font-size: 12px;
    letter-spacing: 0.3em;
    color: var(--white-dim);
    text-transform: uppercase;
    position: relative;
    overflow: hidden;
  }
  .loc-map-placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 50%, rgba(40,84,120,0.3), transparent 70%);
  }
  .loc-pin {
    font-size: 32px;
    position: relative;
    z-index: 1;
  }

  /* ============ ESPAÇOS ============ */
  #espacos {
    background: var(--navy-mid);
    padding: 120px 0;
  }
  .espacos-intro {
    text-align: center;
    margin-bottom: 80px;
  }
  .espacos-intro .section-title {
    margin-bottom: 20px;
  }
  .espacos-intro p {
    font-size: 17px;
    color: var(--white-dim);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.8;
  }
  .espacos-tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--white-faint);
    margin-bottom: 60px;
  }
  .tab-btn {
    font-family: 'Quicksand', sans-serif;
    font-size: 12px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--white-dim);
    background: none;
    border: none;
    cursor: pointer;
    padding: 16px 32px;
    position: relative;
    transition: color 0.3s;
  }
  .tab-btn.active { color: var(--gold); }
  .tab-btn.active::after {
    content: '';
    position: absolute;
    bottom: -1px; left: 0; right: 0;
    height: 1px;
    background: var(--gold);
  }
  .tab-panel { display: none; }
  .tab-panel.active { display: block; }
  .espaco-detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }
  .espaco-visual {
    background: var(--navy-light);
    height: 420px;
    position: relative;
    overflow: hidden;
  }
  .espaco-visual-bg {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Quicksand', sans-serif;
    font-size: 80px;
    color: var(--white-faint);
  }
  .espaco-name {
    font-family: 'Abril Text', serif;
    font-style: italic;
    font-size: 48px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .espaco-capacity {
    font-family: 'Quicksand', sans-serif;
    font-size: 12px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 32px;
  }
  .espaco-desc {
    font-size: 16px;
    line-height: 1.85;
    color: var(--white-dim);
    margin-bottom: 32px;
  }
  .espaco-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .espaco-features li {
    font-family: 'Quicksand', sans-serif;
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--white-dim);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .espaco-features li::before {
    content: '';
    display: block;
    width: 20px;
    height: 1px;
    background: var(--gold);
    flex-shrink: 0;
  }

  /* ============ TECNOLOGIA ============ */
  #tecnologia {
    background: var(--navy);
    padding: 120px 0;
  }
  .tech-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 2px;
    margin-top: 60px;
  }
  .tech-card {
    background: var(--navy-light);
    padding: 48px 40px;
  }
  .tech-icon {
    font-size: 28px;
    margin-bottom: 20px;
  }
  .tech-card-title {
    font-family: 'Abril Text', serif;
    font-style: italic;
    font-size: 26px;
    font-weight: 600;
    margin-bottom: 16px;
    line-height: 1.2;
  }
  .tech-card-text {
    font-size: 14px;
    line-height: 1.8;
    color: var(--white-dim);
  }

  /* ============ PARCEIROS INTRO ============ */
  #parceiros-intro {
    background: var(--navy-mid);
    padding: 120px 0;
    text-align: center;
  }
  .parceiros-intro-inner {
    max-width: 700px;
    margin: 0 auto;
    padding: 0 60px;
  }
  .parceiros-intro-inner p {
    font-size: 18px;
    line-height: 1.85;
    color: var(--white-dim);
    margin-top: 32px;
  }

  /* ============ PARCEIRO CAROL ============ */
  #carol {
    background: var(--navy);
    padding: 120px 0;
  }
  .parceiro-layout {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 80px;
    align-items: start;
  }
  .parceiro-card {
    background: var(--navy-light);
    padding: 60px 48px;
    position: sticky;
    top: 100px;
  }
  .parceiro-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--navy-light), var(--blue-accent));
    margin-bottom: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Quicksand', sans-serif;
    font-size: 32px;
    color: var(--white);
  }
  .parceiro-name {
    font-family: 'Abril Text', serif;
    font-style: italic;
    font-size: 36px;
    font-weight: 600;
    margin-bottom: 8px;
    line-height: 1.1;
  }
  .parceiro-role {
    font-family: 'Quicksand', sans-serif;
    font-size: 11px;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 28px;
  }
  .parceiro-bio {
    font-size: 14px;
    line-height: 1.8;
    color: var(--white-dim);
    margin-bottom: 28px;
  }
  .parceiro-instagram {
    font-family: 'Quicksand', sans-serif;
    font-size: 12px;
    letter-spacing: 0.2em;
    color: var(--white-dim);
    border-top: 1px solid var(--white-faint);
    padding-top: 20px;
    margin-top: 8px;
  }
  .entrevista {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .entrevista-header {
    padding-bottom: 32px;
    border-bottom: 1px solid var(--white-faint);
    margin-bottom: 8px;
  }
  .entrevista-header h3 {
    font-family: 'Abril Text', serif;
    font-style: italic;
    font-size: 28px;
    font-weight: 300;
    
    color: var(--gold);
    margin-bottom: 12px;
  }
  .entrevista-header p {
    font-size: 14px;
    color: var(--white-dim);
    line-height: 1.7;
  }
  .qa-item {}
  .qa-pergunta {
    font-family: 'Quicksand', sans-serif;
    font-size: 11px;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 12px;
  }
  .qa-q {
    font-family: 'Abril Text', serif;
    font-style: italic;
    font-size: 22px;
    
    line-height: 1.4;
    color: var(--white);
    margin-bottom: 20px;
  }
  .qa-a {
    font-size: 15px;
    line-height: 1.9;
    color: var(--white-dim);
    padding-left: 24px;
    border-left: 1px solid var(--white-faint);
  }
  .qa-placeholder {
    font-size: 13px;
    color: rgba(245,243,239,0.35);
    
    padding-left: 24px;
    border-left: 1px solid rgba(207,230,248,0.2);
  }

  /* ============ PARCEIRO THIAGO ============ */
  #thiago {
    background: var(--navy-mid);
    padding: 120px 0;
  }

  /* ============ VALORES ============ */
  #valores {
    background: var(--navy);
    padding: 120px 0;
  }
  .valores-headline {
    text-align: center;
    margin-bottom: 80px;
  }
  .valores-headline h2 {
    font-family: 'Abril Text', serif;
    font-style: italic;
    font-size: clamp(28px, 3vw, 44px);
    font-weight: 300;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }
  .valores-headline h2 em {  color: var(--gold); }
  .valores-table {
    background: var(--navy-light);
    border-top: 1px solid var(--gold);
    margin-bottom: 48px;
  }
  .valores-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--white-faint);
  }
  .valores-row:last-child { border-bottom: none; }
  .valores-cell {
    padding: 28px 48px;
    display: flex;
    align-items: center;
  }
  .valores-cell:first-child {
    border-right: 1px solid var(--white-faint);
  }
  .valores-row-header {
    background: rgba(207,230,248,0.05);
  }
  .valores-row-header .valores-cell {
    font-family: 'Quicksand', sans-serif;
    font-size: 11px;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--gold);
    padding: 16px 48px;
  }
  .val-quantidade {
    font-family: 'Quicksand', sans-serif;
    font-size: 28px;
    font-weight: 500;
    line-height: 1;
  }
  .val-price {
    font-family: 'Abril Text', serif;
    font-style: italic;
    font-size: 36px;
    font-weight: 600;
    color: var(--gold);
    line-height: 1;
  }
  .val-price-sub {
    font-family: 'Quicksand', sans-serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--white-dim);
    margin-top: 4px;
    text-transform: uppercase;
  }
  .valores-note {
    text-align: center;
    font-size: 14px;
    line-height: 1.8;
    color: var(--white-dim);
    max-width: 680px;
    margin: 0 auto;
  }

  /* ============ INCLUSO ============ */
  #incluso {
    background: var(--navy-mid);
    padding: 120px 0;
  }
  .incluso-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    margin-top: 60px;
  }
  .incluso-group {
    background: var(--navy-light);
    padding: 48px 40px;
  }
  .incluso-group-title {
    font-family: 'Quicksand', sans-serif;
    font-size: 11px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 28px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--white-faint);
  }
  .incluso-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .incluso-list li {
    font-size: 14px;
    line-height: 1.5;
    color: var(--white-dim);
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .incluso-check {
    color: var(--gold-light);
    font-size: 12px;
    margin-top: 1px;
    flex-shrink: 0;
  }

  /* ============ ENCERRAMENTO ============ */
  #encerramento {
    background: var(--navy);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
  }
  .enc-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 50% at 50% 60%, rgba(40,84,120,0.4), transparent 70%),
      radial-gradient(ellipse 30% 30% at 80% 20%, rgba(207,230,248,0.05), transparent 60%);
  }
  .enc-line {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
  }
  .enc-content {
    position: relative;
    z-index: 2;
    padding: 60px;
  }
  .enc-logo {
    font-family: 'Quicksand', sans-serif;
    font-size: 11px;
    letter-spacing: 0.6em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 60px;
  }
  .enc-title {
    font-family: 'Abril Text', serif;
    font-style: italic;
    font-size: clamp(48px, 7vw, 100px);
